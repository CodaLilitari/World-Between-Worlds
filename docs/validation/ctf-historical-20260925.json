    {
      "archive": "motsctf.zip",
      "title": "MotS CTF 1.0",
      "author": "hedge",
      "readme_release_date": "April 1998",
      "readme_url": "https://jkdf2.net/JKBot/JKArchive/JKDF2/JKDF2/Game%20Files/motskfy/info/motsctf/motsctf.txt",
      "summary": "Three stock JK CTF maps. README requires Team mode for team skins and suggests a separate items.dat override to suppress the red-flag ysalamiri icon. It explicitly omits colored lights because the author lacked a 3D card; it does not itself state that lighting is broken.",
      "permissions_summary": "README permits use as a base for additional levels and free distribution with its unmodified notice. Boilerplate disclaims LEC sounds despite the feature list identifying JK announcer WAVs; no legal clearance is inferred and no historical content is redistributed."
    },
    {
      "archive": "sith-ctf.zip",
      "title": "Mysteries of the Sith: Capture the Flag",
      "version": "1.0",
      "author": "Marc Sauvé",
      "readme_release_date": "99/02/03",
      "readme_url": "https://jkdf2.net/JKBot/JKArchive/JKDF2/JKDF2/Game%20Files/motskfy/info/sith-ctf/sith-ctf.txt",
      "summary": "Explicitly credits hedge as the basis; also requires Team mode for team skins. Three worlds and all shared COGs are identical to hedge. Episode title and final transition differ, and two ysalamiri bitmap members are added.",
      "permissions_summary": "Distribution section contains a LucasArts disclaimer without an additional express grant; no historical content is redistributed."
    }
  ],
